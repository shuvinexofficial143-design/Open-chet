# Browser: public values only. Leave blank to use isolated local demo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Supabase transaction pooler URI; TLS is enforced.
DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Server-only encryption key for per-number Meta tokens (32 random bytes, base64 or 64-char hex).
WHATSAPP_TOKEN_ENCRYPTION_KEY=
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Set a version supported by your Meta app (for example v23.0).
META_GRAPH_VERSION=
# OpenAI-compatible provider; no provider is required for manual use.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
# Long random secret. Cron or an external scheduler invokes /api/worker.
CRON_SECRET=
